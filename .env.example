# SheetStorm configuration. Copy to .env (start.sh does this for you) and edit.
# Never commit .env - only this example file is tracked.
# Full reference: assets/docs/configuration.md

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=sheetstorm
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=sheetstorm
# Used for non-Docker development only; docker-compose builds the URL from the values above.
DATABASE_URL=postgresql://sheetstorm:changeme_in_production@database:5432/sheetstorm

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Backend core ────────────────────────────────────────────────────────────
# production (default) enforces non-default signing secrets and Secure cookies.
# Use development only on a developer machine (enables the Werkzeug debugger).
FLASK_ENV=production
# Generate each with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# (start.sh generates SECRET_KEY, JWT_SECRET_KEY and FERNET_KEY on first run)
SECRET_KEY=changeme_generate_32_char_random_string
JWT_SECRET_KEY=changeme_generate_another_32_char_string
FERNET_KEY=changeme_generate_fernet_key_base64

# HMAC key for chain-of-custody signatures. Kept separate from SECRET_KEY so that
# rotating SECRET_KEY does not invalidate custody records. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset the backend falls back to SECRET_KEY (with a startup warning).
# Do NOT change it once evidence has been recorded without reading the rotation
# guidance in assets/docs/configuration.md - existing signatures stop verifying.
CUSTODY_SIGNING_KEY=

# Comma-separated browser origins allowed to call the API (credentialed CORS and
# Socket.IO). Leave empty for localhost-only defaults. REQUIRED when users reach
# SheetStorm through any other host, e.g. https://sheetstorm.example.com
CORS_ORIGINS=
# Public base URL of the UI (used for OAuth redirects and links), e.g. https://sheetstorm.example.com
FRONTEND_URL=

# Auth cookies are marked Secure (HTTPS only) in production. Serve SheetStorm over
# HTTPS (recommended). Browsers accept Secure cookies on http://localhost and
# http://127.0.0.1 (not Safari). For plain-HTTP access from any other host
# (e.g. http://192.168.1.10:8080) logins will silently fail unless you set this
# to false - only do that on a trusted network.
JWT_COOKIE_SECURE=true

# Hosts/CIDRs admins may point self-hosted integrations at (private/internal
# addresses are blocked by default to prevent SSRF). Comma-separated, e.g.
#   OUTBOUND_URL_ALLOWLIST=ollama,misp.internal,10.0.0.0/8
OUTBOUND_URL_ALLOWLIST=

# Seconds a just-rotated refresh token is still accepted once (multi-tab refresh races)
JWT_REFRESH_GRACE_SECONDS=30

# Rate limit applied to all API routes (Flask-Limiter syntax)
RATE_LIMIT_DEFAULT=600 per minute

# Automatically enrich newly added IOCs through configured threat-intel
# integrations. Off by default because it sends indicators to third parties.
IOC_AUTO_ENRICH=false

# ─── Reverse proxy / CDN (bundled nginx proxy) ───────────────────────────────
# Default (empty): nginx trusts nobody and uses the real TCP peer address as the
# client IP, ignoring client-supplied X-Forwarded-For / CF-Connecting-IP / etc.
# That is correct when SheetStorm is exposed directly.
# If SheetStorm sits behind a load balancer, ingress, tunnel or CDN, list ONLY the
# proxies you control (comma-separated IPs/CIDRs, IPv4 and IPv6), otherwise the
# client IPs in rate limiting, audit logs and chain of custody are those of the proxy.
# WARNING: trusting a range you do not control lets clients forge their IP.
#   TRUSTED_PROXY_CIDRS=10.0.0.0/8
# Header the trusted proxy uses for the client IP: X-Forwarded-For (default),
# X-Real-IP, CF-Connecting-IP or True-Client-IP. See assets/docs/configuration.md
# (Cloudflare preset: proxy/presets/cloudflare-ips.txt).
TRUSTED_PROXY_CIDRS=
REAL_IP_HEADER=X-Forwarded-For

# ─── Admin seed ──────────────────────────────────────────────────────────────
# The admin user is created on first run. Change the password after first login.
ADMIN_EMAIL=admin@sheetstorm.local
ADMIN_PASSWORD=changeme_admin_password

# ─── Supabase (optional SSO) ─────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── OAuth providers (also configurable in the UI; env values are fallbacks) ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_FOLDER_ID=

# ─── S3-compatible evidence storage (optional; UI configurable) ───────────────
# Without S3/Drive, evidence is stored in the artifacts_data Docker volume.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=sheetstorm-artifacts
S3_REGION=us-east-1

# ─── AI providers (optional; UI configurable) ────────────────────────────────
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
# Key for a generic OpenAI-compatible endpoint (vLLM, LM Studio, LiteLLM, ...)
OPENAI_COMPATIBLE_API_KEY=
# Base URL of an OpenAI-compatible server (vLLM, LM Studio, llama.cpp, ...).
# Paired only with OPENAI_COMPATIBLE_API_KEY - OPENAI_API_KEY is never sent here.
OPENAI_BASE_URL=
# Local LLM via Ollama (start with: docker compose --profile local-llm up -d)
# Self-hosted hosts must also be listed in OUTBOUND_URL_ALLOWLIST (e.g. ollama).
OLLAMA_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_TIMEOUT=120

# ─── Notifications (optional; UI configurable) ───────────────────────────────
SLACK_WEBHOOK_URL=

# ─── Frontend ────────────────────────────────────────────────────────────────
# Relative paths work through the nginx proxy on any host/IP. Only set absolute
# URLs if NOT using the proxy (e.g. direct dev access). Build-time values.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=

# ─── MCP server ──────────────────────────────────────────────────────────────
# Public URL clients reach the MCP server at (must match the proxy/host exactly).
MCP_ISSUER_URL=http://localhost:8811
MCP_LOG_LEVEL=INFO
# Extra hostnames MCP OAuth clients may redirect to after login (comma-separated).
# Loopback redirects (localhost/127.0.0.1) are always allowed. Example:
#   MCP_ALLOWED_REDIRECT_HOSTS=claude.ai,chatgpt.com
MCP_ALLOWED_REDIRECT_HOSTS=
