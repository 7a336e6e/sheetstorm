# Dependencies
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# Environment & secrets (never commit real values; keep only *.env.example)
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
client_secret*.json
*service-account*.json
.localsecrets

# Build outputs
.next/
out/
build/
dist/
*.egg-info/
*.tsbuildinfo
# Regenerated by `next dev` / `next build` / `next typegen` (Next 16 rewrites it
# per mode, so tracking it only produces churn).
frontend/next-env.d.ts

# IDE
.idea/
.vscode/
*.swp
*.swo
.agent/

# OS
.DS_Store
Thumbs.db

# Testing (backend/tests/ IS tracked; only caches/reports are ignored)
coverage/
.coverage
.pytest_cache/
htmlcov/
playwright-report/
test-results/
.playwright-mcp/

# Logs
*.log
logs/

# Local runtime artifacts (root only - do not match source dirs such as
# frontend/src/app/dashboard/incidents/[id]/artifacts/)
/artifacts/
.claude/
# .github/ itself is tracked (dependabot.yml, future workflows); only local
# AI-assistant files inside it are ignored.
.github/copilot-instructions.md
.github/agent/

# Docker
docker-compose.override.yml

# Persistent data (database, redis)
/data/
!backend/app/data/

# Agent related stuff (local tooling, not part of the product)
tasks.md
mcp-server/.venv/
test_oauth_flow.py
/prompts/
.aigentic/
.gemini/
.mcp.json
AGENTS.md
CLAUDE.md
ORCHESTRATOR.md
GEMINI.md

# ─── AIGentic Framework ──────────────────────────────────────────────────────
# Task board state (ephemeral, per-session)
.aigentic/board/active/
.aigentic/board/review/
.aigentic/board/done/
.aigentic/board/failed/

# Execution history (can be large)
.aigentic/runs/

# Framework log
.aigentic/aigentic.log

# Skills / personas / playbooks (root-level agent tooling only)
/skills/
/agents/
/playbooks/
.plans/
