# Supply-chain hardening - see assets/docs/supply-chain.md
# Never run dependency lifecycle scripts (preinstall/install/postinstall are the
# Shai-Hulud-style worm entry point). Allowlist explicitly via `npm rebuild <pkg>`.
ignore-scripts=true
# Write exact versions to package.json on `npm install <pkg>` (no ^/~ ranges).
save-exact=true
audit=true
fund=false
engine-strict=false
# No git/URL dependencies (they bypass registry integrity + malware scanning).
allow-git=none
# Only resolve versions published at least 7 days ago on `npm install`/`update`
# (npm >= 11.10; older npm ignores it with a warning - use --before=<date>).
# `npm ci` installs exactly what the lockfile says and is not affected.
min-release-age=7
