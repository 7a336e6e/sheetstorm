# SheetStorm MCP Bridge Configuration
# Copy this file to .env and fill in your values

# --- Required: SheetStorm backend URL ---
# Point this at your SheetStorm instance's API endpoint
SHEETSTORM_API_URL=https://your-sheetstorm-instance.com/api/v1

# --- Authentication (choose one method) ---
# Precedence: SHEETSTORM_API_KEY > SHEETSTORM_API_TOKEN > USERNAME/PASSWORD.

# Method 1 (recommended): a scoped API key. Create it in SheetStorm under your
# profile (or, for a service account, Settings > API Keys). It is exchanged for
# 15-minute tokens, works with MFA-enabled accounts and can be revoked at any
# time. Prefer injecting it from your MCP client config / secret store, e.g.
# "SHEETSTORM_API_KEY": "${env:SHEETSTORM_API_KEY}", instead of writing it here.
# SHEETSTORM_API_KEY=ssk_xxxxxxxxxxxx_...

# Method 2 (legacy): Username/Password. Does not support MFA.
# SHEETSTORM_USERNAME=your-email@example.com
# SHEETSTORM_PASSWORD=your-password

# Method 3 (legacy): a pre-issued JWT (expires; no automatic renewal)
# SHEETSTORM_API_TOKEN=your-jwt-token

# --- Optional ---
# LOG_LEVEL=INFO
# HTTP_TIMEOUT=30
# HTTP_MAX_RETRIES=2
