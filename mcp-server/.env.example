# SheetStorm MCP Server Configuration
# =====================================

# SheetStorm Backend API URL
SHEETSTORM_API_URL=http://localhost:5000/api/v1

# MCP Transport: stdio (local, single user) or sse (remote, multi-user OAuth;
# serves both /sse and Streamable HTTP /mcp)
MCP_TRANSPORT=stdio

# --- stdio transport ONLY -----------------------------------------------------
# Static credentials are used only when MCP_TRANSPORT=stdio. The remote (sse)
# transport ignores them: every user signs in through the browser OAuth flow.
# Precedence: SHEETSTORM_API_KEY > SHEETSTORM_API_TOKEN > USERNAME/PASSWORD.
#
# Recommended: a scoped API key (create it in SheetStorm under your profile or,
# for a service account, Settings > API Keys). It is exchanged for 15-minute
# tokens, works with MFA-enabled accounts and can be revoked at any time.
# Prefer injecting it from your MCP client config / secret store instead of
# writing it here, e.g. "SHEETSTORM_API_KEY": "${env:SHEETSTORM_API_KEY}".
# SHEETSTORM_API_KEY=ssk_xxxxxxxxxxxx_...
#
# Legacy: pre-issued JWT (expires; no automatic renewal)
# SHEETSTORM_API_TOKEN=your-jwt-token-here
# Legacy: username/password auto-login (no MFA support)
# SHEETSTORM_USERNAME=you@example.com
# SHEETSTORM_PASSWORD=your-password

# --- sse transport ------------------------------------------------------------
# Port of the HTTP server.
MCP_SSE_PORT=8811

# Public issuer URL the server advertises in its OAuth metadata. It MUST match
# the host:port clients actually reach (the port above, or your public proxy)
# — otherwise OAuth discovery and redirects break.
MCP_ISSUER_URL=http://localhost:8811

# Redis URL for persisting dynamically registered OAuth clients (90-day sliding
# TTL). Optional — without it registrations are in-memory only.
# REDIS_URL=redis://localhost:6379/0

# OAuth redirect URIs are restricted to loopback (http://127.0.0.1, http://localhost)
# unless the https host is listed here (comma-separated, exact host names), e.g.
# claude.ai for Claude web connectors or vscode.dev for VS Code for the Web.
# MCP_ALLOWED_REDIRECT_HOSTS=claude.ai,vscode.dev

# Root directory for artifact upload/download paths on the remote server. Each
# user gets a private 0700 subdirectory <ARTIFACT_DIR>/<org_id>/<user_id>/ and
# tool paths are relative to it. (Not used on stdio.)
ARTIFACT_DIR=/tmp/sheetstorm-artifacts

# --- common -------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# HTTP client timeout in seconds
HTTP_TIMEOUT=30

# HTTP client max retries for transient failures
HTTP_MAX_RETRIES=2
